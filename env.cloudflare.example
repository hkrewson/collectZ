# Copy this file to .env.cloudflare and replace both placeholder values.
# .env.cloudflare is ignored by git because the tunnel token is a credential.

# Public hostname configured as a Published application route in Cloudflare.
# In the Cloudflare dashboard, point this hostname to http://frontend:3000.
CLOUDFLARE_HOSTNAME=collectz-dev.your-domain.example

# Remotely managed tunnel token from Cloudflare Dashboard > Networking > Tunnels
# > your tunnel > Add a replica. Store only the token, not the full Docker command.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional runtime tuning.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARED_LOG_LEVEL=info
TUNNEL_TRUST_PROXY=1

# Keep false for this local development overlay. The public browser connection is
# HTTPS, but the local cloudflared -> Nginx -> backend hops are HTTP.
TUNNEL_SESSION_COOKIE_SECURE=false

